{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/organization-membership.schema.json",
  "title": "VSN Organization Membership",
  "description": "Tenant-bound organization membership resolved before authorization. Authentication-provider details and credentials are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "membership_id",
    "subject_id",
    "organization_id",
    "status",
    "roles",
    "permissions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "membership_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subject_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "organization_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": {
      "type": "string",
      "enum": ["active", "invited", "suspended"]
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9._:-]*$"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._:-]*$"
      }
    }
  }
}
