{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/authorization-context.schema.json",
  "title": "VSN Authorization Context",
  "description": "Tenant-bound authorization context passed across trusted control-plane boundaries after authentication and membership resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "organization_id",
    "membership_id",
    "roles",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "membership_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9._:-]*$"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._:-]*$"
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
