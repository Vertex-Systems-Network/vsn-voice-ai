{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/desktop-link-record.schema.json",
  "title": "VSN Desktop Link Record",
  "description": "Server-side state for a short-lived single-use desktop linking exchange. Raw exchange tokens and browser session secrets are intentionally not part of this persisted contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "token_digest",
    "subject_id",
    "organization_id",
    "device_id",
    "issued_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "token_digest": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["issued", "consumed", "revoked", "expired"]
    },
    "consumed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
