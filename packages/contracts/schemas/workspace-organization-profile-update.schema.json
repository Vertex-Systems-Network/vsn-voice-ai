{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/workspace-organization-profile-update.schema.json",
  "title": "VSN Workspace Organization Profile Update",
  "description": "Closed tenant organization display-profile update.",
  "type": "object",
  "additionalProperties": false,
  "required": ["display_name"],
  "properties": {
    "display_name": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:[^\\u0000-\\u001F\\u007F])*$"
    }
  }
}
