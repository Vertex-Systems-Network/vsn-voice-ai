{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/workspace-authorization-summary.schema.json",
  "title": "VSN Workspace Authorization Summary",
  "description": "Browser-safe tenant authorization summary. Trusted subject/session identifiers and authentication credentials are intentionally excluded from this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organization_id",
    "membership_id",
    "roles",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "membership_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9._:-]*$"
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9._:-]*$"
      }
    }
  }
}
