{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/desktop-link-issue-response.schema.json",
  "title": "VSN Desktop Link Issue Response",
  "description": "Short-lived one-time desktop link exchange response. The raw exchange token must never be persisted in desktop link records or logs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "exchange_token", "expires_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "exchange_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    }
  }
}
