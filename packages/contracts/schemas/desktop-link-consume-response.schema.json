{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/desktop-link-consume-response.schema.json",
  "title": "VSN Desktop Link Consume Response",
  "description": "Browser/desktop-safe confirmation of a completed one-time desktop link exchange. Subject and session identifiers are intentionally omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "linked",
    "record_id",
    "organization_id",
    "device_id",
    "consumed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "linked": { "const": true },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "consumed_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    }
  }
}
