{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/workspace-team.schema.json",
  "title": "VSN Workspace Team Response",
  "description": "Tenant-authorized, browser-safe workspace team read model. Internal subject/session identifiers, credentials, email addresses, permission lists and free-form profile metadata are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organization_id",
    "members",
    "has_more"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "organization_id": {
      "$ref": "#/$defs/identifier"
    },
    "members": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "authorityToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "membership_id",
        "display_name",
        "status",
        "roles"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "membership_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "active",
            "invited",
            "suspended"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/authorityToken"
          }
        },
        "display_name": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(?:[^\\u0000-\\u001F\\u007F])*$"
            }
          ]
        }
      }
    }
  }
}
