{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/desktop-link-status-response.schema.json",
  "title": "VSN Desktop Link Status Response",
  "description": "Tenant-authorized browser-safe desktop-link lifecycle status. Subject, session, token digest and raw exchange token are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "organization_id",
    "device_id",
    "status",
    "expires_at",
    "consumed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "organization_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*\\S.*" },
    "device_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*\\S.*" },
    "status": { "enum": ["issued", "consumed", "revoked", "expired"] },
    "expires_at": { "type": "string", "minLength": 20, "maxLength": 40 },
    "consumed_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 20, "maxLength": 40 }
      ]
    }
  }
}
