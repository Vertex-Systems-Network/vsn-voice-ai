{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.internal/schemas/provider-manifest.schema.json",
  "title": "ProviderManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "access_mode", "capabilities", "enabled", "verified_access", "health"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "access_mode": {"enum": ["api", "sdk", "local", "on_prem", "internal"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "regions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "enabled": {"type": "boolean"},
    "verified_access": {"type": "boolean"},
    "health": {"enum": ["healthy", "degraded", "unhealthy", "circuit_open"]},
    "latency_p95_ms": {"type": "integer", "minimum": 0},
    "quality_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "privacy_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "cost_microunits_per_minute": {"type": "integer", "minimum": 0},
    "retention_policy": {"type": "string"}
  }
}
