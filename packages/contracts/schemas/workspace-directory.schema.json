{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/workspace-directory.schema.json",
  "title": "VSN Workspace Directory Response",
  "description": "Authenticated subject-bound workspace membership summaries. Subject/session identifiers, permissions, credentials and profile data are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspaces",
    "has_more"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspaces": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/workspace"
      }
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "authorityToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "membership_id",
        "organization_id",
        "status",
        "roles"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "membership_id": {
          "$ref": "#/$defs/identifier"
        },
        "organization_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "active",
            "invited",
            "suspended"
          ]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/authorityToken"
          }
        }
      }
    }
  }
}
