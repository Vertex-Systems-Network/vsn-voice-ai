{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vsn.local/desktop-link-inventory-response.schema.json",
  "title": "VSN Linked Desktop Inventory Response",
  "description": "Browser-safe latest consumed desktop link per device for the authenticated subject in one organization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization_id", "devices", "has_more"],
  "properties": {
    "schema_version": { "const": 1 },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": ".*\\S.*"
    },
    "devices": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "record_id", "device_id", "linked_at"],
        "properties": {
          "schema_version": { "const": 1 },
          "record_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": ".*\\S.*"
          },
          "linked_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 40
          }
        }
      }
    },
    "has_more": { "type": "boolean" }
  }
}
