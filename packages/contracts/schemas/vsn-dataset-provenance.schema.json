{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.internal/schemas/vsn-dataset-provenance.schema.json",
  "title": "VSNDatasetProvenance",
  "description": "Metadata-only provenance record for a restricted VSN proprietary training/evaluation dataset. This contract contains no dataset content, storage path, URL or credential and does not authorize training or production-to-research transfer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "classification",
    "storage_class",
    "customer_content_policy",
    "source_provenance_refs",
    "rights_review_status",
    "deletion_lineage_status",
    "deletion_lineage_ref",
    "retention_policy_ref",
    "production_to_research_transfer_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {
      "type": "string",
      "pattern": "^DATASET-[A-Z0-9][A-Z0-9._-]{0,63}$"
    },
    "classification": {"const": "restricted"},
    "storage_class": {"const": "segregated_research_storage"},
    "customer_content_policy": {
      "enum": ["excluded", "separately_authorized"]
    },
    "authorization_evidence_ref": {
      "type": "string",
      "pattern": "^EVIDENCE-[A-Z0-9][A-Z0-9._-]{0,95}$"
    },
    "source_provenance_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVIDENCE-[A-Z0-9][A-Z0-9._-]{0,95}$"
      }
    },
    "rights_review_status": {
      "enum": ["verification_required", "verified"]
    },
    "deletion_lineage_status": {
      "enum": ["verification_required", "verified"]
    },
    "deletion_lineage_ref": {
      "type": "string",
      "pattern": "^EVIDENCE-[A-Z0-9][A-Z0-9._-]{0,95}$"
    },
    "retention_policy_ref": {
      "type": "string",
      "pattern": "^EVIDENCE-[A-Z0-9][A-Z0-9._-]{0,95}$"
    },
    "production_to_research_transfer_status": {
      "enum": ["not_applicable", "verification_required", "verified"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"customer_content_policy": {"const": "separately_authorized"}},
        "required": ["customer_content_policy"]
      },
      "then": {
        "required": ["authorization_evidence_ref"],
        "properties": {
          "production_to_research_transfer_status": {"const": "verified"}
        }
      },
      "else": {
        "properties": {
          "production_to_research_transfer_status": {"const": "not_applicable"}
        },
        "not": {"required": ["authorization_evidence_ref"]}
      }
    }
  ]
}
